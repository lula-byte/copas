rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function roomPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode);
    }

    function getRoom(roomCode) {
      return get(roomPath(roomCode)).data;
    }

    function getRoomAfter(roomCode) {
      return getAfter(roomPath(roomCode)).data;
    }

    function metaPath(roomCode) {
      return /databases/$(database)/documents/rooms/$(roomCode)/leaderboardMeta/state;
    }

    function getMeta(roomCode) {
      return get(metaPath(roomCode)).data;
    }

    function getMetaAfter(roomCode) {
      return getAfter(metaPath(roomCode)).data;
    }

    function playerPath(roomCode, playerId) {
      return /databases/$(database)/documents/rooms/$(roomCode)/players/$(playerId);
    }

    function isRoomHost(roomCode) {
      return isSignedIn() && exists(roomPath(roomCode)) && getRoom(roomCode).hostUid == request.auth.uid;
    }

    // Compare candidate leaderboard entry against current rank #20 threshold
    function outranksThreshold(entry, meta) {
      return entry.score > meta.minScore
        || (entry.score == meta.minScore && entry.level > meta.minLevel)
        || (entry.score == meta.minScore && entry.level == meta.minLevel && entry.totalCompleted > meta.minTotalCompleted);
    }

    // 3. Entity Validation Blueprints
    function isValidRoom(data, roomCode) {
      return data.keys().hasAll([
        'roomCode', 'hostUid', 'hostName', 'status', 'createdAt', 'updatedAt',
        'challengeSeed', 'roundNumber', 'maxPlayers', 'playerCount'
      ])
      && data.keys().hasOnly([
        'roomCode', 'hostUid', 'hostName', 'status', 'createdAt', 'updatedAt',
        'countdownStartedAt', 'startTime', 'endTime',
        'challengeSeed', 'roundNumber', 'maxPlayers', 'playerCount'
      ])
      && data.roomCode is string && data.roomCode == roomCode && isValidRoomCode(data.roomCode)
      && data.hostUid is string && isValidId(data.hostUid)
      && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40
      && data.status in ['waiting', 'countdown', 'playing', 'finished']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && (!('countdownStartedAt' in data) || data.countdownStartedAt == null || data.countdownStartedAt is timestamp)
      && (!('startTime' in data) || data.startTime == null || data.startTime is timestamp)
      && (!('endTime' in data) || data.endTime == null || data.endTime is timestamp)
      && data.challengeSeed is int && data.challengeSeed >= 1
      && data.roundNumber is int && data.roundNumber >= 1
      && data.maxPlayers is int && data.maxPlayers == 25
      && data.playerCount is int && data.playerCount >= 0 && data.playerCount <= 25;
    }

    function isValidPlayer(data, playerId) {
      return data.keys().hasAll([
        'uid', 'name', 'normalizedKey', 'avatarColor', 'score', 'level',
        'lives', 'completed', 'totalCompleted', 'status', 'roundNumber',
        'joinedAt', 'lastSeen'
      ])
      && data.keys().hasOnly([
        'uid', 'name', 'normalizedKey', 'avatarColor', 'score', 'level',
        'lives', 'completed', 'totalCompleted', 'status', 'roundNumber',
        'joinedAt', 'lastSeen'
      ])
      && data.uid is string && data.uid == playerId && isValidId(data.uid)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 30
      && data.normalizedKey is string && isValidId(data.normalizedKey)
      && data.avatarColor is string && data.avatarColor.size() >= 4 && data.avatarColor.size() <= 20
      && data.score is int && data.score >= 0 && data.score <= 1000000
      && data.level is int && data.level >= 1 && data.level <= 999
      && data.lives is int && data.lives >= 0 && data.lives <= 5
      && data.completed is int && data.completed >= 0 && data.completed <= 15
      && data.totalCompleted is int && data.totalCompleted >= 0 && data.totalCompleted <= 10000
      && data.status in ['connected', 'disconnected', 'eliminated']
      && data.roundNumber is int && data.roundNumber >= 1
      && data.joinedAt is timestamp
      && data.lastSeen is timestamp;
    }

    function isValidNameLock(data) {
      return data.keys().hasAll(['uid', 'name'])
        && data.keys().hasOnly(['uid', 'name'])
        && data.uid is string && isValidId(data.uid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 30;
    }

    function isValidLeaderboardEntry(data, entryId) {
      return data.keys().hasAll([
        'uid', 'name', 'avatarColor', 'score', 'level', 'completed',
        'totalCompleted', 'lives', 'status', 'roundNumber', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid', 'name', 'avatarColor', 'score', 'level', 'completed',
        'totalCompleted', 'lives', 'status', 'roundNumber', 'updatedAt'
      ])
      && data.uid is string && data.uid == entryId && isValidId(data.uid)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 30
      && data.avatarColor is string && data.avatarColor.size() >= 4 && data.avatarColor.size() <= 20
      && data.score is int && data.score >= 1 && data.score <= 1000000
      && data.level is int && data.level >= 1 && data.level <= 999
      && data.completed is int && data.completed >= 0 && data.completed <= 15
      && data.totalCompleted is int && data.totalCompleted >= 1 && data.totalCompleted <= 10000
      && data.lives is int && data.lives >= 0 && data.lives <= 5
      && data.status in ['connected', 'disconnected', 'eliminated']
      && data.roundNumber is int && data.roundNumber >= 1
      && data.updatedAt is timestamp;
    }

    function isValidLeaderboardMeta(data) {
      return data.keys().hasAll([
        'roundNumber', 'count', 'entryUids', 'minEntryUid',
        'minScore', 'minLevel', 'minTotalCompleted', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'roundNumber', 'count', 'entryUids', 'minEntryUid',
        'minScore', 'minLevel', 'minTotalCompleted', 'updatedAt'
      ])
      && data.roundNumber is int && data.roundNumber >= 1
      && data.count is int && data.count >= 0 && data.count <= 20
      && data.entryUids is list
      && data.entryUids.size() == data.count
      && data.entryUids.size() <= 20
      && (data.entryUids.size() == 0 || data.entryUids[0] is string)
      && (data.minEntryUid == null || (data.minEntryUid is string && isValidId(data.minEntryUid)))
      && data.minScore is int && data.minScore >= 0 && data.minScore <= 1000000
      && data.minLevel is int && data.minLevel >= 0 && data.minLevel <= 999
      && data.minTotalCompleted is int && data.minTotalCompleted >= 0 && data.minTotalCompleted <= 10000
      && data.updatedAt is timestamp;
    }

    // 4. Connection check document
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
    }

    // 5. Rooms Collection
    match /rooms/{roomCode} {
      allow get: if isSignedIn() && isValidRoomCode(roomCode);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && incoming().hostUid == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().playerCount == 0
        && incoming().roundNumber == 1
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidRoom(incoming(), roomCode)
        && incoming().roomCode == existing().roomCode
        && incoming().hostUid == existing().hostUid
        && incoming().createdAt == existing().createdAt
        && incoming().maxPlayers == existing().maxPlayers
        && incoming().updatedAt == request.time
        && (
          (
            existing().hostUid == request.auth.uid
            && existing().status == 'waiting'
            && incoming().status == 'countdown'
            && existing().playerCount >= 1
            && incoming().countdownStartedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'countdownStartedAt', 'updatedAt'])
          )
          || (
            existing().hostUid == request.auth.uid
            && existing().status == 'countdown'
            && incoming().status == 'playing'
            && incoming().startTime == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startTime', 'updatedAt'])
          )
          || (
            existing().hostUid == request.auth.uid
            && existing().status in ['countdown', 'playing']
            && incoming().status == 'finished'
            && incoming().endTime == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'endTime', 'updatedAt'])
          )
          || (
            existing().hostUid == request.auth.uid
            && existing().status == 'finished'
            && incoming().status == 'waiting'
            && incoming().roundNumber == existing().roundNumber + 1
            && incoming().countdownStartedAt == null
            && incoming().startTime == null
            && incoming().endTime == null
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'roundNumber', 'challengeSeed', 'countdownStartedAt', 'startTime', 'endTime', 'updatedAt'
            ])
          )
          || (
            existing().status == 'waiting'
            && existing().playerCount < 25
            && incoming().playerCount == existing().playerCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['playerCount', 'updatedAt'])
            && !exists(playerPath(roomCode, request.auth.uid))
            && existsAfter(playerPath(roomCode, request.auth.uid))
          )
          || (
            existing().status == 'waiting'
            && existing().playerCount > 0
            && incoming().playerCount == existing().playerCount - 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['playerCount', 'updatedAt'])
            && exists(playerPath(roomCode, request.auth.uid))
            && !existsAfter(playerPath(roomCode, request.auth.uid))
          )
        );

      allow delete: if isSignedIn()
        && isValidRoomCode(roomCode)
        && existing().hostUid == request.auth.uid;

      // 6. Players Subcollection
      match /players/{playerId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(playerId);
        allow list: if isSignedIn() && isValidRoomCode(roomCode) && resource.data.roundNumber >= 1;

        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && playerId == request.auth.uid
          && isValidPlayer(incoming(), playerId)
          && exists(roomPath(roomCode))
          && getRoom(roomCode).status == 'waiting'
          && getRoom(roomCode).playerCount < 25
          && incoming().score == 0
          && incoming().level == 1
          && incoming().lives == 5
          && incoming().completed == 0
          && incoming().totalCompleted == 0
          && incoming().status == 'connected'
          && incoming().roundNumber == getRoom(roomCode).roundNumber
          && incoming().joinedAt == request.time
          && incoming().lastSeen == request.time
          && getRoomAfter(roomCode).playerCount == getRoom(roomCode).playerCount + 1
          && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/names/$(incoming().normalizedKey))
          && getAfter(/databases/$(database)/documents/rooms/$(roomCode)/names/$(incoming().normalizedKey)).data.uid == request.auth.uid;

        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && isValidPlayer(incoming(), playerId)
          && exists(roomPath(roomCode))
          && incoming().uid == existing().uid
          && incoming().name == existing().name
          && incoming().normalizedKey == existing().normalizedKey
          && incoming().avatarColor == existing().avatarColor
          && incoming().joinedAt == existing().joinedAt
          && incoming().lastSeen == request.time
          && (
            (
              getRoom(roomCode).hostUid == request.auth.uid
              && getRoomAfter(roomCode).roundNumber == existing().roundNumber + 1
              && incoming().roundNumber == existing().roundNumber + 1
              && incoming().score == 0
              && incoming().level == 1
              && incoming().lives == 5
              && incoming().completed == 0
              && incoming().totalCompleted == 0
              && incoming().status == 'connected'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'score', 'level', 'lives', 'completed', 'totalCompleted', 'status', 'roundNumber', 'lastSeen'
              ])
            )
            || (
              playerId == request.auth.uid
              && getRoom(roomCode).status != 'finished'
              && existing().status != 'eliminated'
              && incoming().status in ['connected', 'disconnected']
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'lastSeen'])
            )
            || (
              playerId == request.auth.uid
              && getRoom(roomCode).status == 'playing'
              && existing().status != 'eliminated'
              && existing().lives > 0
              && incoming().status == 'connected'
              && incoming().totalCompleted == existing().totalCompleted + 1
              && incoming().score == existing().score + (10 * existing().level)
              && (
                (
                  existing().completed < 14
                  && incoming().completed == existing().completed + 1
                  && incoming().level == existing().level
                  && incoming().lives == existing().lives
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'score', 'completed', 'totalCompleted', 'status', 'lastSeen'
                  ])
                )
                || (
                  existing().completed == 14
                  && incoming().completed == 0
                  && incoming().level == existing().level + 1
                  && incoming().lives == 5
                  && incoming().diff(existing()).affectedKeys().hasOnly([
                    'score', 'level', 'lives', 'completed', 'totalCompleted', 'status', 'lastSeen'
                  ])
                )
              )
            )
            || (
              playerId == request.auth.uid
              && getRoom(roomCode).status == 'playing'
              && existing().status != 'eliminated'
              && existing().lives > 0
              && incoming().lives == existing().lives - 1
              && (
                (incoming().lives > 0 && incoming().status == 'connected')
                || (incoming().lives == 0 && incoming().status == 'eliminated')
              )
              && incoming().diff(existing()).affectedKeys().hasOnly(['lives', 'status', 'lastSeen'])
            )
          );

        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(playerId)
          && (
            (playerId == request.auth.uid && exists(roomPath(roomCode)) && getRoom(roomCode).status == 'waiting')
            || isRoomHost(roomCode)
          );
      }

      // 7. Player Name Uniqueness Locks
      match /names/{nameKey} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(nameKey);
        allow list: if false;

        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(nameKey)
          && isValidNameLock(incoming())
          && incoming().uid == request.auth.uid
          && exists(roomPath(roomCode))
          && getRoom(roomCode).status == 'waiting';

        allow update: if false;

        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(nameKey)
          && (
            (existing().uid == request.auth.uid && exists(roomPath(roomCode)) && getRoom(roomCode).status == 'waiting')
            || isRoomHost(roomCode)
          );
      }

      // 8. Top-20-Only Leaderboard Gatekeeper
      match /leaderboardMeta/{docId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && docId == 'state';
        allow list: if false;

        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && docId == 'state'
          && isValidLeaderboardMeta(incoming())
          && existsAfter(roomPath(roomCode))
          && getRoomAfter(roomCode).hostUid == request.auth.uid
          && incoming().count == 0
          && incoming().entryUids.size() == 0
          && incoming().minEntryUid == null
          && incoming().minScore == 0
          && incoming().minLevel == 0
          && incoming().minTotalCompleted == 0
          && incoming().roundNumber == getRoomAfter(roomCode).roundNumber
          && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && docId == 'state'
          && isValidLeaderboardMeta(incoming())
          && exists(roomPath(roomCode))
          && incoming().updatedAt == request.time
          && (
            // Host resets leaderboard to empty for PLAY AGAIN
            (
              getRoom(roomCode).hostUid == request.auth.uid
              && getRoomAfter(roomCode).roundNumber == existing().roundNumber + 1
              && incoming().roundNumber == existing().roundNumber + 1
              && incoming().count == 0
              && incoming().entryUids.size() == 0
              && incoming().minEntryUid == null
              && incoming().minScore == 0
              && incoming().minLevel == 0
              && incoming().minTotalCompleted == 0
            )
            // Student updates leaderboard metadata atomically alongside their own leaderboard write
            || (
              getRoom(roomCode).status == 'playing'
              && incoming().roundNumber == existing().roundNumber
              && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(request.auth.uid))
              && (
                // Case A: Already in Top 20 (count stays same, UID set unchanged)
                (
                  request.auth.uid in existing().entryUids
                  && incoming().count == existing().count
                  && incoming().entryUids.hasAll(existing().entryUids)
                  && existing().entryUids.hasAll(incoming().entryUids)
                )
                // Case B: Space available (< 20 entries, adding self)
                || (
                  !(request.auth.uid in existing().entryUids)
                  && existing().count < 20
                  && incoming().count == existing().count + 1
                  && incoming().entryUids.hasAll(existing().entryUids)
                  && request.auth.uid in incoming().entryUids
                )
                // Case C: Full (20 entries), replacing old #20 with self
                || (
                  !(request.auth.uid in existing().entryUids)
                  && existing().count == 20
                  && incoming().count == 20
                  && existing().minEntryUid != null
                  && existing().minEntryUid in existing().entryUids
                  && !(existing().minEntryUid in incoming().entryUids)
                  && request.auth.uid in incoming().entryUids
                  && !existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(existing().minEntryUid))
                )
              )
            )
          );

        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && docId == 'state'
          && isRoomHost(roomCode);
      }

      // 9. Top-20-Only Leaderboard Entries (Rank 21+ never stored)
      match /leaderboard/{entryId} {
        allow get: if isSignedIn() && isValidRoomCode(roomCode) && isValidId(entryId);
        allow list: if isSignedIn() && isValidRoomCode(roomCode) && resource.data.score >= 1;

        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(entryId)
          && entryId == request.auth.uid
          && isValidLeaderboardEntry(incoming(), entryId)
          && exists(roomPath(roomCode))
          && getRoom(roomCode).status == 'playing'
          && incoming().roundNumber == getRoom(roomCode).roundNumber
          && incoming().updatedAt == request.time
          && existsAfter(playerPath(roomCode, entryId))
          && incoming().score == getAfter(playerPath(roomCode, entryId)).data.score
          && incoming().level == getAfter(playerPath(roomCode, entryId)).data.level
          && incoming().totalCompleted == getAfter(playerPath(roomCode, entryId)).data.totalCompleted
          && incoming().completed == getAfter(playerPath(roomCode, entryId)).data.completed
          && incoming().lives == getAfter(playerPath(roomCode, entryId)).data.lives
          && incoming().name == getAfter(playerPath(roomCode, entryId)).data.name
          && exists(metaPath(roomCode))
          && (
            (
              getMeta(roomCode).count < 20
              && getMetaAfter(roomCode).count == getMeta(roomCode).count + 1
            )
            || (
              getMeta(roomCode).count == 20
              && getMetaAfter(roomCode).count == 20
              && getMeta(roomCode).minEntryUid != null
              && getMeta(roomCode).minEntryUid != entryId
              && outranksThreshold(incoming(), getMeta(roomCode))
              && exists(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(getMeta(roomCode).minEntryUid))
              && !existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(getMeta(roomCode).minEntryUid))
            )
          );

        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(entryId)
          && entryId == request.auth.uid
          && isValidLeaderboardEntry(incoming(), entryId)
          && exists(roomPath(roomCode))
          && getRoom(roomCode).status == 'playing'
          && incoming().uid == existing().uid
          && incoming().name == existing().name
          && incoming().avatarColor == existing().avatarColor
          && incoming().roundNumber == existing().roundNumber
          && incoming().updatedAt == request.time
          && existsAfter(playerPath(roomCode, entryId))
          && incoming().score == getAfter(playerPath(roomCode, entryId)).data.score
          && incoming().level == getAfter(playerPath(roomCode, entryId)).data.level
          && incoming().totalCompleted == getAfter(playerPath(roomCode, entryId)).data.totalCompleted
          && incoming().completed == getAfter(playerPath(roomCode, entryId)).data.completed
          && incoming().lives == getAfter(playerPath(roomCode, entryId)).data.lives
          && incoming().status == getAfter(playerPath(roomCode, entryId)).data.status;

        allow delete: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(entryId)
          && (
            isRoomHost(roomCode)
            || (
              exists(roomPath(roomCode))
              && getRoom(roomCode).status == 'playing'
              && exists(metaPath(roomCode))
              && getMeta(roomCode).count == 20
              && getMeta(roomCode).minEntryUid == entryId
              && entryId != request.auth.uid
              && !exists(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/rooms/$(roomCode)/leaderboard/$(request.auth.uid))
            )
          );
      }
    }

    // 10. Dedicated Solo Leaderboard (strictly isolated from Multiplayer)
    function isValidSoloEntry(data) {
      return data.keys().hasAll([
        'uid', 'name', 'avatarColor', 'score', 'level', 'totalCompleted',
        'durationSeconds', 'mode', 'createdAt'
      ])
      && data.keys().hasOnly([
        'uid', 'name', 'avatarColor', 'score', 'level', 'totalCompleted',
        'durationSeconds', 'mode', 'createdAt'
      ])
      && data.uid is string && isValidId(data.uid)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 30
      && data.avatarColor is string && data.avatarColor.size() >= 4 && data.avatarColor.size() <= 20
      && data.score is int && data.score >= 1 && data.score <= 1000000
      && data.level is int && data.level >= 1 && data.level <= 999
      && data.totalCompleted is int && data.totalCompleted >= 1 && data.totalCompleted <= 10000
      && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
      && data.mode is string && data.mode == 'solo'
      && data.createdAt is timestamp;
    }

    match /soloLeaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn() && resource.data.score >= 1;

      allow create: if isSignedIn()
        && isValidId(entryId)
        && isValidSoloEntry(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // 11. Dedicated Global Multiplayer Leaderboard (verified against room player state)
    function isValidMultiplayerLeaderboardEntry(data) {
      return data.keys().hasAll([
        'roomCode', 'roundNumber', 'uid', 'name', 'avatarColor', 'score',
        'level', 'totalCompleted', 'mode', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'roomCode', 'roundNumber', 'uid', 'name', 'avatarColor', 'score',
        'level', 'totalCompleted', 'mode', 'updatedAt'
      ])
      && data.roomCode is string && isValidRoomCode(data.roomCode)
      && data.roundNumber is int && data.roundNumber >= 1
      && data.uid is string && isValidId(data.uid)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 30
      && data.avatarColor is string && data.avatarColor.size() >= 4 && data.avatarColor.size() <= 20
      && data.score is int && data.score >= 1 && data.score <= 1000000
      && data.level is int && data.level >= 1 && data.level <= 999
      && data.totalCompleted is int && data.totalCompleted >= 1 && data.totalCompleted <= 10000
      && data.mode is string && data.mode == 'multiplayer'
      && data.updatedAt is timestamp;
    }

    match /multiplayerLeaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId);
      allow list: if isSignedIn() && resource.data.score >= 1;

      allow create, update: if isSignedIn()
        && isValidId(entryId)
        && isValidMultiplayerLeaderboardEntry(incoming())
        && incoming().uid == request.auth.uid
        && incoming().updatedAt == request.time
        && entryId == (incoming().roomCode + '_r' + string(incoming().roundNumber) + '_' + request.auth.uid)
        && existsAfter(playerPath(incoming().roomCode, request.auth.uid))
        && incoming().score == getAfter(playerPath(incoming().roomCode, request.auth.uid)).data.score
        && incoming().level == getAfter(playerPath(incoming().roomCode, request.auth.uid)).data.level
        && incoming().totalCompleted == getAfter(playerPath(incoming().roomCode, request.auth.uid)).data.totalCompleted
        && incoming().name == getAfter(playerPath(incoming().roomCode, request.auth.uid)).data.name;

      allow delete: if false;
    }
  }
}
